  "info": {
    "title": "AI Project Workspace API",
    "description": "Foundation endpoints only. Authentication and workspace features are not implemented yet.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@workspace.local"
          },
          "password": {
            "type": "string",
            "example": "SecretPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "OldPassword123!"
          },
          "newPassword": {
            "type": "string",
            "example": "NewSecretPass456!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@workspace.local"
          },
          "displayName": {
            "type": "string",
            "example": "Alice Smith"
          },
          "systemRole": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ],
            "default": "USER"
          },
          "professionalRole": {
            "type": "string",
            "enum": [
              "PM",
              "DEVELOPER",
              "QA",
              "DX",
              "INFRASTRUCTURE",
              "PRESENTATION"
            ],
            "default": "DEVELOPER"
          },
          "password": {
            "type": "string",
            "description": "Initial password. If omitted, a temporary random password will be generated.",
            "example": "InitialPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "displayName",
          "systemRole",
          "professionalRole"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Alice Smith"
          },
          "systemRole": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "professionalRole": {
            "type": "string",
            "enum": [
              "PM",
              "DEVELOPER",
              "QA",
              "DX",
              "INFRASTRUCTURE",
              "PRESENTATION"
            ]
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "temporaryPassword": {
            "type": "string",
            "description": "Set a new temporary password for the user, requiring change on next login.",
            "example": "TempPass987!",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "AIW",
            "description": "Unique project key identifier (2-10 uppercase alphanumeric characters)"
          },
          "name": {
            "type": "string",
            "example": "AI Workspace Core",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "example": "Central backend workspace for multi-modal project management"
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Renamed Project",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "example": "Updated project description"
          },
          "version": {
            "type": "number",
            "description": "Expected version number for optimistic concurrency control",
            "example": 1
          }
        }
      },
      "AddMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "accessRole": {
            "type": "string",
            "enum": [
              "MANAGER",
              "CONTRIBUTOR",
              "VIEWER"
            ],
            "example": "CONTRIBUTOR"
          }
        },
        "required": [
          "userId",
          "accessRole"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "accessRole": {
            "type": "string",
            "enum": [
              "MANAGER",
              "CONTRIBUTOR",
              "VIEWER"
            ],
            "example": "MANAGER"
          }
        },
