{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database and local storage are available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency unavailable; no private details returned."
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "AI Project Workspace API",
    "description": "Foundation endpoints only. Authentication and workspace features are not implemented yet.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}
