{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database and local storage are available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency unavailable; no private details returned."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AuthController_getCsrfToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "CSRF token returned"
          }
        },
        "summary": "Bootstrap or retrieve CSRF token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, returns profile and CSRF token"
          },
          "401": {
            "description": "Invalid credentials or deactivated account"
          }
        },
        "summary": "Log in with credentials and obtain session cookie",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked successfully"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Log out and revoke current session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get current authenticated user profile",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "patch": {
        "operationId": "AuthController_changePassword",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated successfully"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Change password for current user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "UsersController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Filter by display name or email substring",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "systemRole",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ADMIN",
                "USER"
              ]
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated user list"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "List users with pagination and search (Admin only)",
        "tags": [
          "Users"
        ]
      },
      "post": {
        "operationId": "UsersController_create",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Create a new user account (Admin only)",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "operationId": "UsersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get user details by ID (Admin only)",
        "tags": [
          "Users"
        ]
      },
      "patch": {
        "operationId": "UsersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-csrf-token",
            "in": "header",
            "description": "CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Update user account or deactivate (Admin only)",
        "tags": [
          "Users"
        ]
      }
    }
  },
  "info": {
    "title": "AI Project Workspace API",
    "description": "Foundation endpoints only. Authentication and workspace features are not implemented yet.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@workspace.local"
          },
          "password": {
            "type": "string",
            "example": "SecretPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "OldPassword123!"
          },
          "newPassword": {
            "type": "string",
            "example": "NewSecretPass456!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@workspace.local"
          },
          "displayName": {
            "type": "string",
            "example": "Alice Smith"
          },
          "systemRole": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ],
            "default": "USER"
          },
          "professionalRole": {
            "type": "string",
            "enum": [
              "PM",
              "DEVELOPER",
              "QA",
              "DX",
              "INFRASTRUCTURE",
              "PRESENTATION"
            ],
            "default": "DEVELOPER"
          },
          "password": {
            "type": "string",
            "description": "Initial password. If omitted, a temporary random password will be generated.",
            "example": "InitialPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "displayName",
          "systemRole",
          "professionalRole"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Alice Smith"
          },
          "systemRole": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "professionalRole": {
            "type": "string",
            "enum": [
              "PM",
              "DEVELOPER",
              "QA",
              "DX",
              "INFRASTRUCTURE",
              "PRESENTATION"
            ]
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "temporaryPassword": {
            "type": "string",
            "description": "Set a new temporary password for the user, requiring change on next login.",
            "example": "TempPass987!",
            "minLength": 8,
            "maxLength": 128
          }
        }
      }
    }
  }
}
